{
  "name": "arashouse",
  "version": "0.0.0",
  "private": true,
  "description": "A pool of disposable, per-version Aras Innovator instances, leased like treehouse worktrees.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "arashouse": "dist/cli/index.js",
    "arashouse-broker": "dist/broker/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-info.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "npm run typecheck",
    "test": "vitest run",
    "vendor": "npm run build && node scripts/vendor.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "ajv": "^8.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
